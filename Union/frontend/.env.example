VITE_API_BASE_URL=/api
VITE_AUTH_GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google
VITE_AUTH_GITHUB_REDIRECT_URL=http://localhost:8080/auth/github
VITE_GEOLOCATION_ENABLED_DEFAULT=false

# Módulo 004-inspiraciones-perfil — Variables de Integración API
VITE_PERFIL_MOCK_ENABLED=false
VITE_PERFIL_API_ENDPOINT=/api
VITE_FOTO_MAX_SIZE_MB=5
VITE_FOTO_ALLOWED_FORMATS=jpg,jpeg,png,webp
VITE_API_URL=/api
VITE_USE_MOCKS=false

VITE_DESAFIOS_ADAPTER=memoria

# Búsqueda real por defecto. "ejemplo" solo para demos explícitas.
VITE_BUSQUEDA_REPOSITORIO=http
# El proxy de desarrollo dirige /api/push-notifications a este servicio.
PUSH_NOTIFICATIONS_URL=http://localhost:3001
API_PROXY_TARGET=http://localhost:8080
# Configuración pública del proyecto Firebase Web (no JWT_SECRET ni claves privadas).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
