# Frontend Admin — Variables de entorno

# URL base de la API REST
# Desarrollo (local con MSW): /api/v1
# Producción (backend real): https://api.ejemplo.com/v1 u otra URL
VITE_API_URL=/api/v1

# Activar/desactivar MSW (mocks)
# true: usa handlers de tests/mocks/ (desarrollo y testing, recomendado)
# false: conecta a API real en VITE_API_URL (requiere backend disponible)
VITE_USE_MOCKS=true

# Rol simulado en MSW (solo si VITE_USE_MOCKS=true)
# Valores: USER, ADMIN
# Para app admin, usar ADMIN para testing correcto
VITE_MOCK_ROL=ADMIN
